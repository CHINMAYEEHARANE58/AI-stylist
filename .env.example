# ── Backend (apps/server/.env) ─────────────────────────────────────────
NODE_ENV=development
PORT=4000

# PostgreSQL — Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/closetai?schema=public"

# JWT
JWT_SECRET=your-32-plus-char-random-secret-here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
FRONTEND_URL=http://localhost:3000
EMAIL_FROM=ClosetAI <no-reply@example.com>
RESEND_API_KEY=your-resend-api-key
# Create a Google Auth Platform OAuth client of type "Web application".
# Register this exact URL as an authorized redirect URI. Keep the secret server-only.
# See docs/GOOGLE_SIGN_IN.md for the local setup and test-user steps.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
COOKIE_SECURE=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# ClosetAI currently uses signed server-to-Cloudinary uploads. Keep public unless
# a private signed-delivery endpoint has been implemented for your deployment.
IMAGE_STORAGE_VISIBILITY=public
INSPIRATION_STORAGE_PROVIDER=cloudinary
# For single-machine development only, use INSPIRATION_STORAGE_PROVIDER=local.
# Production inspiration images use authenticated Cloudinary delivery.
# INSPIRATION_LOCAL_DIR=./.local-uploads

# AI providers
# Choose `openai` or `gemini` for a real backend-only provider. `mock` is deliberately allowed
# only in NODE_ENV=development and is useful for local UI work; it is not real AI.
AI_PROVIDER=openai
AI_VISION_MODEL=gpt-4o
AI_REQUEST_TIMEOUT_MS=30000
AI_ANALYSIS_CACHE_MINUTES=1440
OPENAI_API_KEY=sk-...
# Optional OpenAI-compatible backend endpoint, for example a configured AI gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
# To use Google Gemini, set AI_PROVIDER=gemini and provide a Google AI Studio key.
# Uses Google's native generateContent API; OPENAI_BASE_URL does not affect Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Weather: disabled unless selected. Open-Meteo's no-key endpoint is for
# non-commercial development/evaluation only; production requires a paid key.
WEATHER_PROVIDER=none
# WEATHER_API_KEY=your_paid_open_meteo_key
WEATHER_TIMEOUT_MS=6000

# Optional licensed shopping-offer feed. Leave disabled until you have an
# authorized API/feed and its permitted merchant domains. Never scrape stores.
SHOPPING_PROVIDER=none
# SHOPPING_FEED_URL=https://your-authorized-feed.example/api/offers
# SHOPPING_FEED_TOKEN=your-feed-token
# SHOPPING_ALLOWED_MERCHANT_HOSTS=merchant.example,another-merchant.example
SHOPPING_OFFER_MAX_AGE_MINUTES=1440
SHOPPING_FEED_TIMEOUT_MS=8000

# ── Frontend (apps/web/.env.local) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
