# ── Backend (apps/server/.env) ─────────────────────────────────────────
NODE_ENV=development
PORT=4000

# PostgreSQL — Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/closetai?schema=public"

# JWT
JWT_SECRET=your-32-plus-char-random-secret-here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
FRONTEND_URL=http://localhost:3000
EMAIL_FROM=ClosetAI <no-reply@example.com>
RESEND_API_KEY=your-resend-api-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
COOKIE_SECURE=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# ClosetAI currently uses signed server-to-Cloudinary uploads. Keep public unless
# a private signed-delivery endpoint has been implemented for your deployment.
IMAGE_STORAGE_VISIBILITY=public
INSPIRATION_STORAGE_PROVIDER=cloudinary
# For single-machine development only, use INSPIRATION_STORAGE_PROVIDER=local.
# Production inspiration images use authenticated Cloudinary delivery.
# INSPIRATION_LOCAL_DIR=./.local-uploads

# AI providers
# `openai` is the normal backend-only provider. `mock` is deliberately allowed
# only in NODE_ENV=development and is useful for local UI work; it is not real AI.
AI_PROVIDER=openai
AI_VISION_MODEL=gpt-4o
AI_REQUEST_TIMEOUT_MS=30000
AI_ANALYSIS_CACHE_MINUTES=1440
OPENAI_API_KEY=sk-...
# Optional OpenAI-compatible backend endpoint, for example a configured AI gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=AIza...

# Weather API
WEATHER_API_KEY=your_weather_api_key

# ── Frontend (apps/web/.env.local) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
